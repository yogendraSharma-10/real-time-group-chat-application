# Server Environment Variables

# The port on which the Node.js server will run.
PORT=5000

# Database connection URL.
# Example for MongoDB: mongodb://localhost:27017/chat_app
# Example for PostgreSQL: postgresql://user:password@localhost:5432/chat_app
DATABASE_URL=mongodb://localhost:27017/chat_app

# Secret key for signing and verifying JSON Web Tokens (JWTs).
# IMPORTANT: Generate a strong, random string for production.
JWT_SECRET=supersecretjwtkeythatshouldbechangedinproduction

# Comma-separated list of allowed origins for CORS (Cross-Origin Resource Sharing).
# This should be the URL of your client application.
# Example: http://localhost:3000,http://your-production-domain.com
CORS_ORIGIN=http://localhost:3000

# Client Environment Variables (for Create React App)
# These variables must be prefixed with REACT_APP_ to be exposed to the client-side bundle.

# The URL of the backend server (where WebSockets will connect).
# This should match the server's host and port.
REACT_APP_SERVER_URL=http://localhost:5000